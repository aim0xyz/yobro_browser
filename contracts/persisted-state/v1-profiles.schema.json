{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "profiles.json Registry v1",
  "type": "object",
  "required": ["profiles", "activeID"],
  "properties": {
    "activeID": {"type": "string", "format": "uuid"},
    "profiles": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "name", "symbol"],
        "properties": {"id": {"type": "string", "format": "uuid"}, "name": {"type": "string", "minLength": 1, "maxLength": 40}, "symbol": {"type": "string"}}},
      "description": "Must contain the original profile 00000000-0000-0000-0000-000000000001; ids unique; activeID present."
    }
  }
}
